{
  "permissions": {
    "allow": [
      "Bash(uv run commands)",
      "Bash(uv run check)",
      "Bash(uv run fmt)",
      "Bash(uv run fmt-check)",
      "Bash(uv run lint)",
      "Bash(uv run types)",
      "Bash(uv run imports)",
      "Bash(uv run tests:*)",
      "Bash(uv run tests-unit:*)",
      "Bash(uv run secrets)",
      "Bash(uv run questions-tune:*)",
      "Bash(uv run eval-retrieval:*)",
      "Bash(uv run eval-smoke:*)",
      "Bash(uv run eval-tune:*)",
      "Bash(uv sync:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/questions.jsonl)",
      "Read(./eval/sets/heldout.json)",
      "Read(./eval/results/heldout/**)",
      "Edit(./data/**)",
      "Write(./data/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/split_reminder.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard_paths.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep|NotebookRead|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard_split.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/format_python.py",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/tests_on_stop.py",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
